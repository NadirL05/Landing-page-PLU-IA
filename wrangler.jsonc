{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fonciable-vitrine",
  "compatibility_date": "2026-11-20",
  "main": "deploy/cloudflare/worker.mjs",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./out",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true
  }
}
